NEXT_PUBLIC_APP_NAME=LocalAgentWorlbase
# NEXT_PUBLIC_APP_COPYRIGHT=Your Name or Company

# Required for Brand / Competitor / Website Intelligence.
DATABASE_URL=postgresql://ai_workspace:replace-this@localhost:5432/ai_workspace
DATABASE_POOL_MAX=10
DATABASE_SSL=false

# Website monitor limits. The crawler also respects robots.txt Crawl-delay up to 10 seconds.
CRAWLER_MAX_PAGES=30
CRAWLER_DELAY_MS=200

# Optional protected scheduled monitoring. Configure only if a cron service will call /api/jobs/monitor.
# CRON_SECRET=replace-with-a-long-random-secret
MONITOR_INTERVAL_HOURS=6
MONITOR_BATCH_SIZE=1
